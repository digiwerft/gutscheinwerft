<?php

use Contao\StringUtil;

$categories = $this->gwShopCategories ? ' categories="' . implode(",", StringUtil::deserialize($this->gwShopCategories)) . '"' : '';
if ($this->gwDevShop) {
    $url = 'https://gw.server.gutscheinwerft.de/load.js';
} else {
    $url = 'https://gw.werft.io/load.js';
}
?>
<?php $this->extend('block_searchable'); ?>
<?php $this->block('content'); ?>

<script src="<?= $url ?>" <?= $categories ?>></script>

<?php $this->endblock(); ?>